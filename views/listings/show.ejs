<% layout("layouts/boilerplate") %>

<div class="row mt-4">
    <div class="col-8 offset-2">
        <h3 class="mb-3"><%= listing.title %></h3>

        <div class="card mb-4" style="border: none;">
            <img
                src="<%= listing.image.url %>"
                class="card-img-top mb-3"
                alt="listing_image"
                style="height: 40vh; object-fit: cover; border-radius: 1rem;"
            >

            <div class="card-body p-0">
                <p class="card-text mt-2 text-muted">
                    <i>Listed by: <b><%= listing.owner.username %></b></i>
                </p>
                
                <p class="card-text mt-3"><%= listing.description %></p>
                <p class="card-text">
                    <b>&#8377; <%= listing.price.toLocaleString("en-IN") %></b> / night
                </p>
                <p class="card-text"><%= listing.location %></p>
                <p class="card-text"><%= listing.country %></p>
            </div>
        </div>

        <div class="d-flex gap-3 mb-5">
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-brand">
                Edit this Listing
            </a>

            <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                <button class="btn btn-dark">Delete this Listing</button>
            </form>
        </div>
    </div>
    
    <hr>
    
    <div class="col-8 offset-2 mb-3">
        <h4 class="mb-3">Leave a Review</h4>
        <form method="POST" action="/listings/<%= listing._id %>/reviews" class="needs-validation" novalidate>
            
            <div class="mb-3">
                <label class="form-label">Rating</label>
                <div class="star-rating">
                    <input type="radio" id="star5" name="review[rating]" value="5" required />
                    <label for="star5" title="5 stars"><i class="fa-solid fa-star"></i></label>
                    
                    <input type="radio" id="star4" name="review[rating]" value="4" />
                    <label for="star4" title="4 stars"><i class="fa-solid fa-star"></i></label>
                    
                    <input type="radio" id="star3" name="review[rating]" value="3" />
                    <label for="star3" title="3 stars"><i class="fa-solid fa-star"></i></label>
                    
                    <input type="radio" id="star2" name="review[rating]" value="2" />
                    <label for="star2" title="2 stars"><i class="fa-solid fa-star"></i></label>
                    
                    <input type="radio" id="star1" name="review[rating]" value="1" />
                    <label for="star1" title="1 star"><i class="fa-solid fa-star"></i></label>
                </div>
            </div>

            <div class="mb-3">
                <label for="comment" class="form-label">Comments</label>
                <textarea id="comment" name="review[comment]" class="form-control" rows="4" placeholder="Write your experience here..." required></textarea>
                <div class="invalid-feedback">
                    Please enter a valid review comment.
                </div>
            </div>

            <button class="btn btn-outline-dark px-4">Submit</button>
        </form>

        <% if(listing.reviews.length > 0) { %>
            <hr class="mt-4 mb-4">
            <h5 class="mb-3"><b>All Reviews (<%= listing.reviews.length %>)</b></h5>
            
            <div class="row row-cols-1 row-cols-md-2 g-3">
                <% for(let review of listing.reviews) { %>
                    <div class="col">
                        <div class="card h-100 review-card p-3 shadow-sm">
                            <div class="card-body p-0">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="user-avatar me-2">
                                        <i class="fa-solid fa-user"></i>
                                    </div>
                                    <div>
                                        <h6 class="card-title mb-0 fw-bold">Guest User</h6>
                                        <small class="text-muted"><%= new Date(review.createdAt).toLocaleDateString("en-IN", { year: 'numeric', month: 'long' }) %></small>
                                    </div>
                                </div>
                                
                                <div class="review-stars mb-2">
                                    <% for(let i=1; i<=5; i++) { %>
                                        <% if(i <= review.rating) { %>
                                            <i class="fa-solid fa-star filled-star"></i>
                                        <% } else { %>
                                            <i class="fa-regular fa-star empty-star"></i>
                                        <% } %>
                                    <% } %>
                                </div>
                                
                                <p class="card-text text-secondary text-break"><%= review.comment %></p>
                                
                                <div class="d-flex justify-content-end mt-3">
                                    <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                        <button class="btn btn-sm btn-outline-danger border-0"><i class="fa-solid fa-trash-can"></i> Delete</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } %>
    </div>
</div>